<Window x:Class="PDFile.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PDFile.App">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- Transparent (not null) so the whole window is a drop target. -->
    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / title bar -->
        <Grid x:Name="TitleBarArea" Height="48" Padding="16,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <local:Icon Width="20" Height="20" Data="{StaticResource IconConvert}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="PDFile" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,0,24,8" Spacing="6">
            <InfoBar x:Name="SessionBar" Severity="Warning" Title="The last session ended abnormally" IsOpen="False">
                <InfoBar.ActionButton>
                    <Button Content="Open logs" Click="OnOpenLogs" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="OfficeBar" Severity="Warning" IsClosable="False" IsOpen="False"
                     Message="Microsoft Office not detected: Word/Excel/PowerPoint files will be skipped" />
        </StackPanel>

        <!-- Controls (shown once a folder or files were chosen) -->
        <StackPanel Grid.Row="2" Margin="24,0,24,12" Spacing="12" Visibility="{x:Bind Vm.HasRoot, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <Button Click="OnChooseFolder" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:Icon Width="18" Height="18" Data="{StaticResource IconFolderOpen}" />
                        <TextBlock Text="Choose folder" />
                    </StackPanel>
                </Button>
                <CheckBox Content="Include subfolders" IsChecked="True" Click="OnIncludeSubfolders" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" />
                <RadioButton x:Name="SeparateRadio" GroupName="Mode" Content="Separate PDFs" IsChecked="True" Checked="OnModeChecked" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" MinWidth="0" />
                <RadioButton x:Name="MergedRadio" GroupName="Mode" Content="One merged PDF" Checked="OnModeChecked" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" MinWidth="0" />
            </StackPanel>
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Vm.OutputLabel, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{x:Bind Vm.OutputPath, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Grid.Column="2" Content="Change..." Click="OnChangeOutput" IsEnabled="{x:Bind Vm.IsIdle, Mode=OneWay}" />
            </Grid>
            <TextBlock Text="{x:Bind Vm.CountText, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Main area: empty state, file list, summary -->
        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <ListView ItemsSource="{x:Bind Vm.Items}" SelectionMode="None" AllowDrop="True"
                          CanReorderItems="{x:Bind Vm.IsMerged, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="40" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:FileItem">
                            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsIncluded, Mode=TwoWay}" MinWidth="0" VerticalAlignment="Center" />
                                <local:Icon Grid.Column="1" Width="20" Height="20" Data="{x:Bind TypeIcon}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind RelativePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <local:Icon Grid.Column="3" Width="18" Height="18" VerticalAlignment="Center"
                                            Visibility="{x:Bind IsFailed, Mode=OneWay}" Data="{StaticResource IconFailure}"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind StatusText, Mode=OneWay}" MinWidth="80" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <StackPanel Visibility="{x:Bind Vm.IsEmpty, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <Button Click="OnChooseFolder" Style="{StaticResource AccentButtonStyle}" Padding="32,16" FontSize="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <local:Icon Width="28" Height="28" Data="{StaticResource IconFolderOpen}" />
                        <TextBlock Text="Choose a folder" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{x:Bind Vm.EmptyHint, Mode=OneWay}" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Finished summary, covers the list until dismissed -->
            <Grid Visibility="{x:Bind Vm.ShowSummary, Mode=OneWay}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <local:Icon Width="24" Height="24" Data="{StaticResource IconSuccess}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                    <TextBlock Text="{x:Bind Vm.SummaryText, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{x:Bind Vm.Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:FailureItem">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,6">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,8">
                                            <local:Icon Width="18" Height="18" Data="{StaticResource IconFailure}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" />
                                                <TextBlock Text="{x:Bind Headline}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="700" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="8">
                                        <TextBox Text="{x:Bind Report}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MaxHeight="280"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                        <Button Click="OnCopyFailure">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <local:Icon Width="16" Height="16" Data="{StaticResource IconCopy}" />
                                                <TextBlock Text="Copy" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnOpenOutput">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:Icon Width="16" Height="16" Data="{StaticResource IconOpenExternal}" />
                            <TextBlock Text="Open output folder" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenMerged" Visibility="{x:Bind Vm.ShowMergedPdf, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:Icon Width="16" Height="16" Data="{StaticResource IconPdf}" />
                            <TextBlock Text="Open merged PDF" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnCopyAllFailures" Visibility="{x:Bind Vm.HasFailures, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <local:Icon Width="16" Height="16" Data="{StaticResource IconCopy}" />
                            <TextBlock Text="Copy all failures" />
                        </StackPanel>
                    </Button>
                    <Button Content="Back to list" Click="OnDismissSummary" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Convert / Stop + progress -->
        <Grid Grid.Row="4" Margin="24,16,24,8" ColumnSpacing="16" RowSpacing="6"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ProgressBar Minimum="0" Maximum="{x:Bind Vm.ProgressTotal, Mode=OneWay}" Value="{x:Bind Vm.ProgressDone, Mode=OneWay}"
                         Visibility="{x:Bind Vm.IsRunning, Mode=OneWay}" VerticalAlignment="Center" />
            <TextBlock Grid.Row="1" Text="{x:Bind Vm.ProgressText, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                       Visibility="{x:Bind Vm.IsRunning, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource AccentButtonStyle}" Padding="32,12" FontSize="18"
                    Click="OnConvertOrStop" IsEnabled="{x:Bind Vm.CanConvert, Mode=OneWay}" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <local:Icon Width="22" Height="22" Data="{x:Bind Vm.ConvertIcon, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Vm.ConvertLabel, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="24,0,24,8">
            <HyperlinkButton Content="Open logs" Click="OnOpenLogs" Padding="0" FontSize="12" />
            <TextBlock x:Name="VersionText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
